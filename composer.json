{
    "name": "chr15k/laravel-response-compression",
    "description": "Laravel response compression middleware",
    "license": "MIT",
    "keywords": [
        "laravel",
        "chr15k",
        "optimize",
        "encoding",
        "performance",
        "php"
    ],
    "authors": [
        {
            "name": "Christopher Keller",
            "email": "ctk8501@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "ext-zlib": "*",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.8|^10.0|^11.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.4",
        "symfony/var-dumper": "^7.1.6|^8.1"
    },
    "autoload": {
        "psr-4": {
            "Chr15k\\ResponseCompression\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chr15k\\ResponseCompression\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chr15k\\ResponseCompression\\ResponseCompressionServiceProvider"
            ]
        }
    },
    "scripts": {
        "refactor": "rector",
        "tidy": [
            "@lint",
            "@refactor",
            "@lint"
        ],
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always --coverage --parallel --min=100",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
